<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Formulario de Evaluación Médica Ocupacional</title>
</head>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    /* Weighted outer border */
    border: 2px solid #000;
    margin-bottom: 10px;
    page-break-inside: avoid;
  }

  .border-heavy-left {
    border-left: 2px solid #000 !important;
  }

  .border-heavy-right {
    border-right: 2px solid #000 !important;
  }

  .border-heavy-top {
    border-top: 2px solid #000 !important;
  }

  .border-heavy-bottom {
    border-bottom: 2px solid #000 !important;
  }

  td,
  th {
    /* Soft/Thin inner borders */
    border: 1px solid #d8d8d8;
    padding: 1px 3px;
    font-size: 7px;
    height: 14px;
    word-wrap: break-word;
    overflow: hidden;
  }

  /* White inner borders for colored headers to mimic Excel */
  .section-title td,
  .item-title,
  .item-subtitle {
    border: 1px solid #d8d8d8;
  }

  .section-title {
    font-size: 10px;
    font-weight: bold;
    background: #ccf;
    text-transform: uppercase;
  }

  .item-title {
    background-color: #ccffcc;
    font-weight: bold;
    text-align: center;
  }

  .item-subtitle {
    background-color: #ccffff;
    text-align: center;
  }

  .text-vertical {
    writing-mode: sideways-lr;
    text-align: center;
    width: 15px;
    height: auto;
    white-space: nowrap;
  }

  .center {
    text-align: center;
  }

  .left {
    text-align: left;
  }

  .bold {
    font-weight: bold;
  }

  .border-none {
    border: none !important;
  }

  .no-border-top {
    border-top: none !important;
  }

  .no-border-bottom {
    border-bottom: none !important;
  }

  .no-border-left {
    border-left: none !important;
  }

  .no-border-right {
    border-right: none !important;
  }
</style>

<body>
  {{#if logo}}
  <div style="width: 100%; display: flex; justify-content: center; align-items: center;">
    <img src="{{logo}}" alt="" style="height: 30px;">
  </div>
  {{/if}}
  <!-- Main Title -->
  <table>
    <thead>
      <tr>
        <th class="section-title" colspan="12">FORMULARIO DE EVALUACIÓN MÉDICA OCUPACIONAL</th>
      </tr>
    </thead>
  </table>

  <br />

  <!-- Section A: Datos del establecimiento -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="12">A. Datos del establecimiento - Datos del Usuario</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="item-title" colspan="2">Institución del Sistema</td>
        <td class="item-title" colspan="2">RUC</td>
        <td class="item-title" colspan="2">CIIU</td>
        <td class="item-title" colspan="2">Establecimiento / Centro de Trabajo</td>
        <td class="item-title" colspan="2">Número de Historia Clinica</td>
        <td class="item-title" colspan="2">Número de Archivo</td>
      </tr>
      <tr>
        <td colspan="2">{{establishment.institutionName}}</td>
        <td colspan="2">{{establishment.ruc}}</td>
        <td colspan="2">{{establishment.ciiu}}</td>
        <td colspan="2">{{establishment.healthFacility}}</td>
        <td colspan="2">{{establishment.clinicalHistoryNumber}}</td>
        <td colspan="2">{{establishment.fileNumber}}</td>
      </tr>

      <tr>
        <td class="item-title" colspan="3">Primer Apellido</td>
        <td class="item-title" colspan="3">Segundo Apellido</td>
        <td class="item-title" colspan="3">Primer Nombre</td>
        <td class="item-title" colspan="3">Segundo Nombre</td>
      </tr>
      <tr>
        <td colspan="3">{{patient.lastName}}</td>
        <td colspan="3">{{patient.secondLastName}}</td>
        <td colspan="3">{{patient.firstName}}</td>
        <td colspan="3">{{patient.middleName}}</td>
      </tr>

      <tr>
        <td class="item-title" colspan="4">Grupo de Atención Prioritaria</td>
        <td class="item-title" colspan="2">Sexo</td>
        <td class="item-title" colspan="3">Fecha de Nacimiento</td>
        <td class="item-title" rowspan="2">Edad</td>
        <td class="item-title" rowspan="2">Grupo Sanguíneo</td>
        <td class="item-title" rowspan="2">Lateralidad</td>
      </tr>
      <tr>
        <td class="item-title text-vertical">Embarazada</td>
        <td class="item-title text-vertical">Persona con Discapacidad</td>
        <td class="item-title text-vertical">Enfermedad Catastrofica</td>
        <td class="item-title text-vertical">Adulto Mayor</td>
        <td class="item-title">Hombre</td>
        <td class="item-title">Mujer</td>
        <td class="item-title">Año</td>
        <td class="item-title">Mes</td>
        <td class="item-title">Día</td>
      </tr>
      <tr>
        <td>{{#if patient.priorityGroup.pregnant}}x{{/if}}</td>
        <td>{{#if patient.priorityGroup.disability}}x{{/if}}</td>
        <td>{{#if patient.priorityGroup.catastrophicIllness}}x{{/if}}</td>
        <td>{{#if patient.priorityGroup.elderly}}x{{/if}}</td>
        <td>{{#if patient.isMale}}x{{/if}}</td>
        <td>{{#if patient.isFemale}}x{{/if}}</td>
        <td>{{patient.birthDate.year}}</td>
        <td>{{patient.birthDate.month}}</td>
        <td>{{patient.birthDate.day}}</td>
        <td>{{patient.age}}</td>
        <td>{{patient.bloodGroup}}</td>
        <td>{{patient.laterality}}</td>
      </tr>
    </tbody>
  </table>

  <br />

  <!-- Section B: Motivo de Consulta -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="12">B. MOTIVO DE CONSULTA</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="item-title" colspan="3">Puesto de Trabajo CIUO</td>
        <td colspan="3">{{consultation.jobPosition}}</td>
        <td class="item-title" colspan="3">Fecha de Atención</td>
        <td colspan="3">{{consultation.serviceDate}}</td>
      </tr>
      <tr>
        <td class="item-title" colspan="4">Fecha de Ingreso al trabajo aaaa/mm/dd</td>
        <td class="item-title" colspan="4">Fecha de Reintegro aaaa/mm/dd</td>
        <td class="item-title" colspan="4">Fecha del Último día laboral/salida aaaa/mm/dd</td>
      </tr>
      <tr>
        <td colspan="4">{{consultation.work.startDate}}</td>
        <td colspan="4">{{consultation.work.returnDate}}</td>
        <td colspan="4">{{consultation.work.lastDate}}</td>
      </tr>
      <tr>
        <td class="item-title left" colspan="12">Tipo de Evaluación</td>
      </tr>
      <tr>
        <td class="item-title" colspan="2">Ingreso</td>
        <td>{{#if consultation.evaluationType.isEntry}}X{{/if}}</td>
        <td class="item-title" colspan="2">Periódica</td>
        <td>{{#if consultation.evaluationType.isPeriodic}}X{{/if}}</td>
        <td class="item-title" colspan="2">Reintegro</td>
        <td>{{#if consultation.evaluationType.isReturn}}X{{/if}}</td>
        <td class="item-title" colspan="2">Retiro</td>
        <td>{{#if consultation.evaluationType.isRetirement}}X{{/if}}</td>
      </tr>
      <tr>
        <td class="border-none bold" colspan="12">Observación</td>
      </tr>
      <tr>
        <td class="border-none" colspan="12">{{consultation.observation}}</td>
      </tr>
    </tbody>
  </table>

  <br />

  <!-- Section C: Antecedentes Personales -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="12">C. Antecedentes Personales</td>
      </tr>
    </thead>
    <tbody>
      <!-- Clinical and Surgical History -->
      <tr>
        <td class="item-title bold left" colspan="12">Antecedentes Clínicos y Quirúrgicos</td>
      </tr>
      <tr>
        <td class="border-none bold" colspan="12">Descripción</td>
      </tr>
      <tr>
        <td class="border-none" colspan="12">{{personalHistory.clinicalAndSurgical}}</td>
      </tr>

      <!-- Family History -->
      <tr>
        <td class="item-title bold left" colspan="12">Antecedentes Familiares</td>
      </tr>
      <tr>
        <td class="border-none bold" colspan="12">Descripción</td>
      </tr>
      <tr>
        <td class="border-none" colspan="12">{{personalHistory.familyHistory}}</td>
      </tr>

      <!-- Special Conditions -->
      <tr>
        <td class="item-title left" style="text-transform: none; font-size: 8px; font-style: italic;" colspan="12">
          Condición especial para las atenciones de urgencia,emergencia,y tratamiento médico (referido por el paciente).
        </td>
      </tr>

      <tr>
        <td class="item-subtitle" rowspan="2" colspan="2">En caso de requerir transfusiones autoriza</td>
        <td class="item-subtitle">Sí</td>
        <td class="item-subtitle">No</td>
        <td class="item-subtitle" rowspan="2" colspan="3">Se encuentra bajo algún tratamiento hormonal</td>
        <td class="item-subtitle">Sí</td>
        <td class="item-subtitle" colspan="2">¿Cuál?</td>
        <td class="item-subtitle">No</td>
        <td class="item-subtitle">No Responde</td>
      </tr>
      <tr>
        <td>{{#if personalHistory.specialConditions.allowsTransfusions}}x{{/if}}</td>
        <td>{{#unless personalHistory.specialConditions.allowsTransfusions}}x{{/unless}}</td>
        <td>{{#if personalHistory.specialConditions.hormoneTherapyAffirmative}}x{{/if}}</td>
        <td colspan="2">{{personalHistory.specialConditions.hormoneTherapyDetails}}</td>
        <td>{{#if personalHistory.specialConditions.hormoneTherapyNegative}}x{{/if}}</td>
        <td>{{#if personalHistory.specialConditions.hormoneTherapyNoAnswer}}x{{/if}}</td>
      </tr>

      <!-- Gynecological History -->
      <tr>
        <td class="item-title bold left" colspan="12">Antecedentes Ginecológicos</td>
      </tr>
      <tr>
        <td class="item-subtitle" rowspan="2" colspan="2">Fecha Última Menstruación</td>
        <td class="item-subtitle" rowspan="2">Embarazos</td>
        <td class="item-subtitle" rowspan="2">Partos</td>
        <td class="item-subtitle" rowspan="2">Cesáreas</td>
        <td class="item-subtitle" rowspan="2">Abortos</td>
        <td class="item-subtitle" colspan="6">Planificación Familiar</td>
      </tr>
      <tr>
        <td class="item-subtitle border-top">Sí</td>
        <td class="item-subtitle border-top" colspan="3">¿Cual?</td>
        <td class="item-subtitle border-top">No</td>
        <td class="item-subtitle border-top">No Responde</td>
      </tr>
      <tr>
        <td colspan="2">{{#if patient.isFemale}} {{personalHistory.gynecological.lastMenstruationDate}} {{/if}}</td>
        <td>{{#if patient.isFemale}} {{personalHistory.gynecological.pregnancies}} {{/if}}</td>
        <td>{{#if patient.isFemale}} {{personalHistory.gynecological.births}} {{/if}}</td>
        <td>{{#if patient.isFemale}} {{personalHistory.gynecological.cesareans}} {{/if}}</td>
        <td>{{#if patient.isFemale}} {{personalHistory.gynecological.abortions}} {{/if}}</td>

        <td>
          {{#if patient.isFemale}}
          {{#if personalHistory.gynecological.familyPlanning.uses}}Si{{/if}}
          {{/if}}</td>
        <td colspan="3">
          {{#if patient.isFemale}}
          {{personalHistory.gynecological.familyPlanning.method}}
          {{/if}}</td>
        <td>
          {{#if patient.isFemale}}
          {{#if personalHistory.gynecological.familyPlanning.doesNotUse}}No usa{{/if}}
          {{/if}}</td>
        <td>
          {{#if patient.isFemale}}
          {{#if personalHistory.gynecological.familyPlanning.noResponse}}No responde{{/if}}
          {{/if}}</td>
      </tr>

      <!-- Gynecological Exams -->
      <tr>
        <td class="item-subtitle border-top" colspan="3">Exámenes Realizados ¿Cual?</td>
        <td class="item-subtitle border-top" colspan="3">Tiempo (años)</td>
        <td class="item-subtitle border-top" colspan="6">Registrar resultado únicamente si interfiere con la actividad
          laboral y previa autorización del titular</td>
      </tr>
      {{#each personalHistory.gynecological.exams}}
      <tr>
        <td colspan="3">{{this.exam}}</td>
        <td colspan="3">{{this.timeYears}}</td>
        <td colspan="6">{{this.results}}</td>
      </tr>
      {{/each}}

      <!-- Male Reproductive History -->
      <tr>
        <td class="item-title border-top bold left" colspan="12">Antecedentes Reproductivos Masculinos</td>
      </tr>

      <tr>
        <td class="item-subtitle" colspan="3">Exámenes Realizados ¿Cual?</td>
        <td class="item-subtitle" colspan="3">Tiempo (años)</td>
        <td class="item-subtitle" colspan="6">Registrar resultado únicamente si interfiere con la actividad laboral y
          previa autorización del titular</td>
      </tr>
      {{#each personalHistory.maleReproductive.exams}}
      <tr>
        <td colspan="3">{{this.exam}}</td>
        <td colspan="3">{{this.time}}</td>
        <td colspan="6">{{this.results}}</td>
      </tr>
      {{/each}}

      <!-- Substance Consumption, Lifestyle, and Habitual Medication -->
      <tr>
        <td class="item-title" colspan="6">Consumo de Sustancias</td>
        <td class="item-title" colspan="3">Estilo de Vida</td>
        <td class="item-title" colspan="3">Condición Preexistente</td>
      </tr>
      <tr>
        <td class="item-subtitle" colspan="2"></td>
        <td class="item-subtitle">Tiempo de Consumo</td>
        <td class="item-subtitle">Ex Consumidor</td>
        <td class="item-subtitle">Tiempo de Abstinencia (meses)</td>
        <td class="item-subtitle">No Consume</td>

        <td rowspan="4">Actividad Física</td>
        <td class="item-subtitle">¿Cuál?</td>
        <td class="item-subtitle">Duración</td>

        <td rowspan="4">Medicación Habitual</td>
        <td class="item-subtitle">¿Cuál?</td>
        <td class="item-subtitle">Cantidad</td>
      </tr>

      {{#each personalHistory.lifeStyle}}
      <tr>
        <td colspan="2">{{this.substanceConsumption.substance}}</td>
        <td>{{this.substanceConsumption.consumptionTime}}</td>
        <td>{{#if this.substanceConsumption.exConsumer}}x{{/if}}</td>
        <td>{{this.substanceConsumption.abstinenceMonths}}</td>
        <td>{{#if this.substanceConsumption.doesNotConsume}}x{{/if}}</td>

        <td>{{this.lifestyle.activity}}</td>
        <td>{{this.lifestyle.duration}}</td>

        <td>{{this.preexistingCondition.medication}}</td>
        <td>{{this.preexistingCondition.quantity}}</td>
      </tr>
      {{/each}}

      <!-- History Observation -->
      <tr>
        <td class="border-none bold" colspan="12">Observación</td>
      </tr>
      <tr>
        <td class="border-none" colspan="12">{{personalHistory.observations}}</td>
      </tr>
    </tbody>
  </table>

  <br />

  <!-- Section D: Enfermedad o problema actual -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="12">D. Enfermedad o problema actual</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="border-none bold" colspan="12">Descripción</td>
      </tr>
      <tr>
        <td class="border-none" colspan="12">{{currentDisease.description}}</td>
      </tr>
    </tbody>
  </table>

  <br />

  <!-- Section E: Constantes Vitales y Antropometría -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="9">E. Constantes Vitales y Antropometría</td>
      </tr>
    </thead>
    <tbody>
      <!-- Vital Signs -->
      <tr>
        <td class="item-title">Temperatura (°C)</td>
        <td class="item-title">Presión Arterial (mmHg)</td>
        <td class="item-title">Frecuencia Cardíaca (lpm)</td>
        <td class="item-title">Frecuencia Respiratoria (fr/min)</td>
        <td class="item-title">Saturación de Oxígeno (%)</td>
        <td class="item-title">Peso (kg)</td>
        <td class="item-title">Talla (cm)</td>
        <td class="item-title">IMC (kg/m2)</td>
        <td class="item-title">Perímetro Abdominal (cm)</td>
      </tr>
      <tr>
        <td>{{vitalSigns.temperature}}</td>
        <td>{{vitalSigns.bloodPressure}}</td>
        <td>{{vitalSigns.heartRate}}</td>
        <td>{{vitalSigns.respiratoryRate}}</td>
        <td>{{vitalSigns.oxygenSaturation}}</td>
        <td>{{vitalSigns.weight}}</td>
        <td>{{vitalSigns.height}}</td>
        <td>{{vitalSigns.bmi}}</td>
        <td>{{vitalSigns.abdominalPerimeter}}</td>
      </tr>

    </tbody>
  </table>

  <br />

  <!-- Section F: Examen Físico Regional -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="15">F. EXAMEN FÍSICO REGIONAL</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="item-title bold left" colspan="15">REGIONES</td>
      </tr>

      <tr>
        <td class="item-subtitle text-vertical" rowspan="2">1. PIEL</td>
        <td class="item-subtitle">a. Cicatrices</td>
        <td class="center">{{#if physicalExam.region.skin.scars}}X{{/if}}</td>

        <td class="item-subtitle text-vertical" rowspan="3">3. OÍDO</td>
        <td class="item-subtitle">a. C. Auditivo Ext.</td>
        <td class="center">{{#if physicalExam.region.ear.externalAuditoryCanal}}X{{/if}}</td>

        <td class="item-subtitle text-vertical" rowspan="4">5. NARIZ</td>
        <td class="item-subtitle">a. Tabique</td>
        <td class="center">{{#if physicalExam.region.nose.septum}}X{{/if}}</td>

        <td class="item-subtitle text-vertical" rowspan="3">8. TÓRAX</td>
        <td class="item-subtitle">a. Pulmones</td>
        <td class="center">{{#if physicalExam.region.thorax.lungs}}X{{/if}}</td>

        <td class="item-subtitle text-vertical" rowspan="2">11. PELVIS</td>
        <td class="item-subtitle">a. Pelvis</td>
        <td class="center">{{#if physicalExam.region.pelvis.pelvis}}X{{/if}}</td>
      </tr>

      <tr>
        <td class="item-subtitle">b. Piel y Faneras</td>
        <td class="center">{{#if physicalExam.region.skin.appendages}}X{{/if}}</td>

        <td class="item-subtitle">b. Pabellón</td>
        <td class="center">{{#if physicalExam.region.ear.auricle}}X{{/if}}</td>

        <td class="item-subtitle">b. Cornetes</td>
        <td class="center">{{#if physicalExam.region.nose.turbinates}}X{{/if}}</td>

        <td class="item-subtitle">b. Corazón</td>
        <td class="center">{{#if physicalExam.region.thorax.heart}}X{{/if}}</td>

        <td class="item-subtitle">b. Genitales</td>
        <td class="center">{{#if physicalExam.region.pelvis.genitals}}X{{/if}}</td>
      </tr>

      <tr>
        <td class="item-subtitle text-vertical" rowspan="5">2. OJOS</td>
        <td class="item-subtitle">a. Párpados</td>
        <td class="center">{{#if physicalExam.region.eye.eyelids}}X{{/if}}</td>

        <td class="item-subtitle">c. Tímpanos</td>
        <td class="center">{{#if physicalExam.region.ear.eardrums}}X{{/if}}</td>

        <td class="item-subtitle">c. Mucosas</td>
        <td class="center">{{#if physicalExam.region.nose.mucosa}}X{{/if}}</td>

        <td class="item-subtitle">c. Parrilla Costal</td>
        <td class="center">{{#if physicalExam.region.thorax.ribCage}}X{{/if}}</td>

        <td class="item-subtitle text-vertical" rowspan="3">12. EXTREM.</td>
        <td class="item-subtitle">a. Vascular</td>
        <td class="center">{{#if physicalExam.region.extremities.vascular}}X{{/if}}</td>
      </tr>

      <tr>
        <td class="item-subtitle">b. Conjuntivas</td>
        <td class="center">{{#if physicalExam.region.eye.conjunctiva}}X{{/if}}</td>

        <td class="item-subtitle text-vertical" rowspan="5">4. OROFAR.</td>
        <td class="item-subtitle">a. Labios</td>
        <td class="center">{{#if physicalExam.region.oropharynx.lips}}X{{/if}}</td>

        <td class="item-subtitle">d. Senos Paranas.</td>
        <td class="center">{{#if physicalExam.region.nose.paranasalSinuses}}X{{/if}}</td>

        <td class="item-subtitle text-vertical" rowspan="2">9. ABDOMEN</td>
        <td class="item-subtitle">a. Vísceras</td>
        <td class="center">{{#if physicalExam.region.abdomen.viscera}}X{{/if}}</td>

        <td class="item-subtitle">b. Miembros Sup.</td>
        <td class="center">{{#if physicalExam.region.extremities.upperLimbs}}X{{/if}}</td>
      </tr>

      <tr>
        <td class="item-subtitle">c. Pupilas</td>
        <td class="center">{{#if physicalExam.region.eye.pupils}}X{{/if}}</td>

        <td class="item-subtitle">b. Lengua</td>
        <td class="center">{{#if physicalExam.region.oropharynx.tongue}}X{{/if}}</td>

        <td class="item-subtitle text-vertical" rowspan="2">6. CUELLO</td>
        <td class="item-subtitle">a. Tiroides/masas</td>
        <td class="center">{{#if physicalExam.region.neck.thyroid}}X{{/if}}</td>

        <td class="item-subtitle">b. Pared Abd.</td>
        <td class="center">{{#if physicalExam.region.abdomen.abdominalWall}}X{{/if}}</td>

        <td class="item-subtitle">c. Miembros Inf.</td>
        <td class="center">{{#if physicalExam.region.extremities.lowerLimbs}}X{{/if}}</td>
      </tr>

      <tr>
        <td class="item-subtitle">d. Córneas</td>
        <td class="center">{{#if physicalExam.region.eye.cornea}}X{{/if}}</td>

        <td class="item-subtitle">c. Faringe</td>
        <td class="center">{{#if physicalExam.region.oropharynx.pharynx}}X{{/if}}</td>

        <td class="item-subtitle">b. Movilidad</td>
        <td class="center">{{#if physicalExam.region.neck.mobility}}X{{/if}}</td>

        <td class="item-subtitle text-vertical" rowspan="3">10. COLUMNA</td>
        <td class="item-subtitle">a. Flexibilidad</td>
        <td class="center">{{#if physicalExam.region.spine.flexibility}}X{{/if}}</td>

        <td class="item-subtitle text-vertical" rowspan="4">13. NEUROL.</td>
        <td class="item-subtitle">a. Fuerza</td>
        <td class="center">{{#if physicalExam.region.neurological.strength}}X{{/if}}</td>
      </tr>

      <tr>
        <td class="item-subtitle">e. Motilidad</td>
        <td class="center">{{#if physicalExam.region.eye.motility}}X{{/if}}</td>

        <td class="item-subtitle">d. Amígdalas</td>
        <td class="center">{{#if physicalExam.region.oropharynx.tonsils}}X{{/if}}</td>

        <td class="item-subtitle">7. TÓRAX</td>
        <td class="item-subtitle">a. Mamas</td>
        <td class="center">{{#if physicalExam.region.thorax.breasts}}X{{/if}}</td>

        <td class="item-subtitle">b. Desviación</td>
        <td class="center">{{#if physicalExam.region.spine.deviation}}X{{/if}}</td>

        <td class="item-subtitle">b. Sensibilidad</td>
        <td class="center">{{#if physicalExam.region.neurological.sensation}}X{{/if}}</td>
      </tr>

      <tr>
        <td colspan="3"></td>
        <td class="item-subtitle">e. Dentadura</td>
        <td class="center">{{#if physicalExam.region.oropharynx.teeth}}X{{/if}}</td>
        <td colspan="3"></td>
        <td class="item-subtitle">c. Dolor</td>
        <td class="center">{{#if physicalExam.region.spine.pain}}X{{/if}}</td>
        <td class="item-subtitle">c. Marcha</td>
        <td class="center">{{#if physicalExam.region.neurological.gait}}X{{/if}}</td>
      </tr>

      <tr>
        <td colspan="12">SI EXISTE EVIDENCIA DE PATOLOGÍA MARCAR CON "X" Y DESCRIBIR ABAJO</td>
        <td class="item-subtitle">d. Reflejos</td>
        <td class="center">{{#if physicalExam.region.neurological.reflexes}}X{{/if}}</td>
      </tr>

      <tr>
        <td class="border-none" colspan="15">
          {{{physicalExam.regionsObservations}}}
        </td>
      </tr>

      <tr>
        <td class="no-border-right bold" colspan="1">Observación</td>
        <td class="no-border-left" colspan="14">{{physicalExam.examObservation}}</td>
      </tr>
    </tbody>
  </table>

  <br />

  <!-- Section G: Factores de Riesgo del Trabajo Actual -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="10">G. FACTORES DE RIESGO DEL TRABAJO ACTUAL</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="item-title" colspan="3">Puesto de Trabajo</td>
        <td colspan="7">{{riskFactors.jobPosition}}</td>
      </tr>
      <tr>
        <td class="item-title" colspan="3" rowspan="2">Actividades importantes jornada laboral</td>
        {{#each riskFactors.activitiesRange}} <td class="item-title bold center">{{this}}</td> {{/each}}
      </tr>
      <tr>
        {{#each riskFactors.activities}} <td>{{this}}</td> {{/each}}
      </tr>

      {{#each riskFactors.sections}}
      {{#each this.items}}
      <tr>
        {{#if @first}}
        <td class="item-title text-vertical" rowspan="{{../rowCount}}" colspan="{{../colspan}}" style="width: 15px;">
          {{../title}}
        </td>
        {{/if}}

        {{#if this.subCategory}}
        <td class="item-title text-vertical" rowspan="{{this.subCategorySpan}}" style="width: 15px;">
          {{this.subCategory}}
        </td>
        {{/if}}

        <td class="item-title left">{{this.label}}</td>

        {{#each this.values}}
        <td class="center ">
          {{#if ../isText}}
          {{this}}
          {{else}}
          {{#if this}}x{{/if}}
          {{/if}}
        </td>
        {{/each}}
      </tr>
      {{/each}}
      {{/each}}

      <tr>
        <td class="item-title left" colspan="3">
          MEDIDAS PREVENTIVAS
        </td>
        {{#each riskFactors.preventiveMeasures}}
        <td class="border-thicker">
          {{this}}
        </td>
        {{/each}}
      </tr>

    </tbody>
  </table>

  <br />

  <!-- Section H: Actividad Laboral/Incidentes/Accidentes/Enfermedades Ocupacionales -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="18">H. ACTIVIDAD LABORAL / INCIDENTES / ACCIDENTES / ENFERMEDADES
          OCUPACIONALES</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="item-title left" colspan="18">ANTECEDENTES DE EMPLEOS ANTERIORES Y/O TRABAJO ACTUAL</td>
      </tr>

      <tr>
        <td class="item-subtitle" rowspan="2" colspan="3">Centro de Trabajo</td>
        <td class="item-subtitle" rowspan="2" colspan="4">Actividades que Desempeñaba</td>
        <td class="item-subtitle" colspan="3">Trabajo</td>
        <td class="item-subtitle" colspan="3">De los Accidentes y Enfermedades</td>
        <td class="item-subtitle" colspan="5">Calificado por IESS</td>
      </tr>

      <tr>
        <td class="item-subtitle text-vertical">Anterior</td>
        <td class="item-subtitle text-vertical">Actual</td>
        <td class="item-subtitle text-vertical">Tiempo</td>
        <td class="item-subtitle text-vertical">Incidente</td>
        <td class="item-subtitle text-vertical">Accidente</td>
        <td class="item-subtitle text-vertical">Enf. Prof.</td>
        <td class="item-subtitle">SI</td>
        <td class="item-subtitle">NO</td>
        <td class="item-subtitle" style="font-size: 6px;">Fecha (aaaa/mm/dd)</td>
        <td class="item-subtitle">Especificar</td>
        <td class="item-subtitle">Observaciones</td>
      </tr>

      {{#each employmentHistory}}
      <tr>
        <td colspan="3">{{workplace}}</td>
        <td colspan="4">{{activities}}</td>
        <td class="center">{{lastWork}}</td>
        <td class="center">{{currentWork}}</td>
        <td class="center">{{duration}}</td>
        <td class="center">{{incident}}</td>
        <td class="center">{{accident}}</td>
        <td class="center">{{disease}}</td>
        <td class="center">{{#if isQualified}}X{{/if}}</td>
        <td class="center">{{#if notQualified}}X{{/if}}</td>
        <td class="center">{{date}}</td>
        <td class="center">{{specification}}</td>
        <td class="center">{{observations}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <br />

  <!-- Section I: Actividades Extra Laborales -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="8">I. Actividades Extra Laborales</td>
      </tr>
    </thead>
    <tbody>
      <!-- Extra-laboral Activities Table Headers -->
      <tr>
        <td class="item-title" colspan="7">Tipo de actividad</td>
        <td class="item-title">Fecha (aaaa/mm/dd)</td>
      </tr>

      <!-- Extra-laboral Activities Data -->
      {{#each extraLaboralActivities}}
      <tr>
        <td colspan="7">{{this.description}}</td>
        <td>{{this.date}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <br />

  <!-- Section J: Resultados de Exámenes Generales y Específicos -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="9">J. RESULTADOS DE EXÁMENES GENERALES Y ESPECÍFICOS DE ACUERDO AL RIESGO Y
          PUESTO DE TRABAJO
          (IMAGEN, LABORATORIO Y OTROS)</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="item-title" colspan="3">Nombre del Examen</td>
        <td class="item-title" colspan="2">Fecha (aaaa/mm/dd)</td>
        <td class="item-title" colspan="4">Resultados</td>
      </tr>

      {{#each examResults.exams}}
      <tr>
        <td colspan="3">{{this.name}}</td>
        <td colspan="2" class="center">{{this.date}}</td>
        <td colspan="4">{{this.results}}</td>
      </tr>
      {{/each}}

      <tr>
        <td class="bold left border-none" colspan="9">OBSERVACIONES:</td>
      </tr>
      <tr>
        <td class="border-none" colspan="9">
          {{examResults.observations}}
        </td>
      </tr>
    </tbody>
  </table>

  <br />

  <!-- Section K: Diagnóstico -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="11">K. DIAGNÓSTICO (PRE: Presuntivo, DEF: Definitivo) [cite: 118, 156]</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="item-title" colspan="3">CIE-10</td>
        <td class="item-title" colspan="6">Descripción</td>
        <td class="item-title">PRE</td>
        <td class="item-title">DEF</td>
      </tr>

      {{#each diagnoses}}
      <tr>
        <td class="center bold no-border-right">{{this.index}}. </td>
        <td class="center no-border-left" colspan="2">{{this.cie}}</td>
        <td class="left" colspan="6">{{this.description}}</td>
        <td class="center">
          {{#if this.presumptive}}X{{/if}}
        </td>
        <td class="center">
          {{#if this.definitive}}X{{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <br />

  <!-- Section L: Aptitud Médica para el Trabajo -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="12">L. APTITUD MÉDICA PARA EL TRABAJO</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="item-title" colspan="2">Apto</td>
        <td class="center">{{#if medicalAptitude.isFit}}X{{/if}}</td>

        <td class="item-title" colspan="2">Apto en Observación</td>
        <td class="center">{{#if medicalAptitude.isFitObservations}}X{{/if}}</td>

        <td class="item-title" colspan="2">Apto con Limitaciones</td>
        <td class="center">{{#if medicalAptitude.isFitLimitations}}X{{/if}}</td>

        <td class="item-title" colspan="2">No Apto</td>
        <td class="center">{{#if medicalAptitude.isNotFit}}X{{/if}}</td>
      </tr>

      <tr>
        <td class="bold left border-none" colspan="12">OBSERVACIONES:</td>
      </tr>
      <tr>
        <td class="border-none" colspan="12">
          {{medicalAptitude.observations}}
        </td>
      </tr>
    </tbody>
  </table>

  <br />

  <!-- Section M: Recomendaciones y/o Tratamiento -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="12">M. RECOMENDACIONES Y/O TRATAMIENTO</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="bold left border-none" colspan="12">DESCRIPCIÓN:</td>
      </tr>
      <tr>
        <td class="border-none" colspan="12">
          {{recommendation.description}}
        </td>
      </tr>
    </tbody>
  </table>

  <br />

  <!-- Section N: Retiro (evaluación) -->
  <table>
    <thead>
      <tr>
        <td class="section-title" colspan="7">N. RETIRO (EVALUACIÓN)</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="item-subtitle left" colspan="3">Se realiza la evaluación</td>
        <td class="item-subtitle center">SÍ</td>
        <td class="center">
          {{#if consultation.evaluationType.isRetirement}}
          {{#if retirementEvaluation.isPerformed}}X{{/if}}
          {{/if}}
        </td>
        <td class="item-subtitle center">NO</td>
        <td class="center">
          {{#if consultation.evaluationType.isRetirement}}
          {{#if retirementEvaluation.isNotPerformed}}X{{/if}}
          {{/if}}
        </td>
      </tr>
      <tr>
        <td class="item-subtitle left" colspan="3">La condición de salud está relacionada con el trabajo
        </td>
        <td class="item-subtitle center">SÍ</td>
        <td class="center">
          {{#if consultation.evaluationType.isRetirement}}
          {{#if retirementEvaluation.isWorkRelated}}X{{/if}}
          {{/if}}
        </td>
        <td class="item-subtitle center">NO</td>
        <td class="center">
          {{#if consultation.evaluationType.isRetirement}}
          {{#if retirementEvaluation.isNotWorkRelated}}X{{/if}}
          {{/if}}
        </td>
      </tr>
      <tr>
        <td class="bold left border-none" colspan="7">OBSERVACIÓN:</td>
      </tr>
      <tr>
        <td colspan="7" class="border-none">
          {{#if consultation.evaluationType.isRetirement}}
          {{retirementEvaluation.observation}}
          {{/if}}
        </td>
      </tr>
    </tbody>
  </table>

  <br />

  <!-- Section O: Professional Data -->
  <table class="border-none">
    <tbody>
      <tr>
        <td class="section-title border-heavy-top border-heavy-left border-heavy-right" colspan="7">O. DATOS DEL
          PROFESIONAL</td>
        <td class="border-none" rowspan="2"></td>
        <td class="section-title border-heavy-top border-heavy-left border-heavy-right" colspan="4">P. FIRMA O HUELLA
          DEL TRABAJADOR</td>
      </tr>
      <tr>
        <td class="border-heavy-bottom border-heavy-left item-subtitle left" colspan="2">Nombres y
          Apellidos:</td>
        <td class="border-heavy-bottom" colspan="2">{{professionalData.fullName}}
        </td>
        <td class="border-heavy-bottom item-subtitle left" colspan="1">Código
          Médico:</td>
        <td class="border-heavy-bottom border-heavy-right" colspan="2">
          {{professionalData.medicalCode}}</td>
        <td class="border-heavy-bottom border-heavy-left border-heavy-right" colspan="4" style="height: 48px;"></td>
      </tr>
    </tbody>
  </table>

</body>

</html>